# Legacy/self-hosted backend API base URL
NEXT_PUBLIC_API_URL=http://localhost:8080

# Server-only proxy origin. In Railway use http://gateway.railway.internal:8080.
# Falls back to NEXT_PUBLIC_API_URL when unset.
# BACKEND_URL=http://localhost:8080

# Matches backend APP_ENV: local | dev | prod (build-time; used for environment banner)
NEXT_PUBLIC_APP_ENV=local

# Frontend origin (OAuth return_to; optional — defaults to window.location.origin)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# MCP endpoint URL is returned as `mcp_url` on each Project from the API (configure SAAS_MCP_* on the backend).

# Vercel Services: set VERCEL_SERVICE_MODE=1 in the branch environment.
# IDENTITY_SERVICE_URL, CONTROL_SERVICE_URL and SYNC_SERVICE_URL are runtime
# bindings supplied by vercel.json; do not copy them from another deployment.
