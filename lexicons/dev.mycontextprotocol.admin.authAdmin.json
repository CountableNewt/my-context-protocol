{
  "lexicon": 1,
  "id": "dev.mycontextprotocol.admin.authAdmin",
  "defs": {
    "main": {
      "type": "permission-set",
      "title": "Admin Admin access",
      "detail": "Call the published operations for this capability. Account authorization, ownership and administrator restrictions still apply.",
      "permissions": [
        {
          "type": "permission",
          "resource": "rpc",
          "inheritAud": true,
          "lxm": [
            "dev.mycontextprotocol.admin.getMetrics",
            "dev.mycontextprotocol.admin.listPrivilegedAccounts",
            "dev.mycontextprotocol.admin.lookupAccount",
            "dev.mycontextprotocol.admin.updateAccountFlags",
            "dev.mycontextprotocol.admin.getTimeseries",
            "dev.mycontextprotocol.admin.refreshRollups"
          ]
        }
      ]
    }
  }
}
