{
  "lexicon": 1,
  "id": "dev.mycontextprotocol.admin.lookupAccount",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "control operation /admin/lookup. Authorization and resource ownership are required.",
      "errors": [
        {
          "name": "InvalidRequest"
        },
        {
          "name": "AuthenticationRequired"
        },
        {
          "name": "Forbidden"
        },
        {
          "name": "NotFound"
        },
        {
          "name": "Conflict"
        },
        {
          "name": "RateLimitExceeded"
        },
        {
          "name": "ServiceUnavailable"
        }
      ],
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "github_login": {
              "type": "string"
            },
            "github_id": {
              "type": "string"
            },
            "email": {
              "type": "string"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "account_id": {
              "type": "string"
            },
            "is_admin": {
              "type": "boolean"
            },
            "paywall_bypass": {
              "type": "boolean"
            }
          },
          "required": [
            "account_id",
            "is_admin",
            "paywall_bypass"
          ]
        }
      }
    }
  }
}
