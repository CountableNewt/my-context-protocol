{
  "lexicon": 1,
  "id": "dev.mycontextprotocol.agent.authClient",
  "defs": {
    "main": {
      "type": "permission-set",
      "title": "Agent access",
      "detail": "Call the published operations for this capability. Account authorization, ownership and administrator restrictions still apply.",
      "permissions": [
        {
          "type": "permission",
          "resource": "rpc",
          "inheritAud": true,
          "lxm": [
            "dev.mycontextprotocol.agent.resolveContext",
            "dev.mycontextprotocol.agent.discoverSkills",
            "dev.mycontextprotocol.agent.listCapabilities",
            "dev.mycontextprotocol.agent.getCatalog",
            "dev.mycontextprotocol.agent.getSkill",
            "dev.mycontextprotocol.agent.reportFeedback",
            "dev.mycontextprotocol.agent.reportUsage",
            "dev.mycontextprotocol.agent.listTools",
            "dev.mycontextprotocol.agent.listResources",
            "dev.mycontextprotocol.agent.listPrompts",
            "dev.mycontextprotocol.agent.readResource",
            "dev.mycontextprotocol.agent.getPrompt",
            "dev.mycontextprotocol.agent.subscribeResource",
            "dev.mycontextprotocol.agent.unsubscribeResource"
          ]
        }
      ]
    }
  }
}
