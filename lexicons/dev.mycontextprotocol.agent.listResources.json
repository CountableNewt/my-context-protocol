{
  "lexicon": 1,
  "id": "dev.mycontextprotocol.agent.listResources",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "mcp operation resources/list. Authorization and resource ownership are required.",
      "errors": [
        {
          "name": "InvalidRequest"
        },
        {
          "name": "AuthenticationRequired"
        },
        {
          "name": "Forbidden"
        },
        {
          "name": "NotFound"
        },
        {
          "name": "Conflict"
        },
        {
          "name": "RateLimitExceeded"
        },
        {
          "name": "ServiceUnavailable"
        }
      ],
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "cursor": {
              "type": "string"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "resources": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "dev.mycontextprotocol.types.defs#resource"
              }
            },
            "nextCursor": {
              "type": "string"
            }
          },
          "required": [
            "resources"
          ]
        }
      }
    }
  }
}
