      "errors": [
        {
          "name": "InvalidRequest"
        },
        {
          "name": "AuthenticationRequired"
        },
        {
          "name": "Forbidden"
        },
        {
          "name": "NotFound"
        },
        {
          "name": "Conflict"
        },
        {
          "name": "RateLimitExceeded"
        },
        {
          "name": "ServiceUnavailable"
        }
      ],
      "parameters": {
        "type": "params",
        "properties": {
