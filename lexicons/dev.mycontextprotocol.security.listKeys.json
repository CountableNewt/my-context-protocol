{
  "lexicon": 1,
  "id": "dev.mycontextprotocol.security.listKeys",
  "defs": {
    "main": {
      "type": "query",
      "description": "control operation /projects/{project_id}/api-keys. Authorization and resource ownership are required.",
      "errors": [
        {
          "name": "InvalidRequest"
        },
        {
          "name": "AuthenticationRequired"
        },
        {
          "name": "Forbidden"
        },
        {
          "name": "NotFound"
        },
        {
          "name": "Conflict"
        },
        {
          "name": "RateLimitExceeded"
        },
        {
          "name": "ServiceUnavailable"
        }
      ],
      "parameters": {
        "type": "params",
        "properties": {
          "project_id": {
            "type": "string"
          },
          "include_revoked": {
            "type": "boolean"
          }
        },
        "required": [
          "project_id"
        ]
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "keys": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "dev.mycontextprotocol.types.defs#apiKey"
              }
            }
          },
          "required": [
            "keys"
          ]
        }
      }
    }
  }
}
