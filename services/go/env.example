# Required by all services. Set actual values through the host secret store.
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=
ENCRYPTION_KEY=
APP_ENV=local
PORT=8080
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
WEBHOOK_BASE_URL=http://localhost:8080

# Identity: preserve these when moving the existing OAuth application.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8080/auth/github/callback
# INTERNAL_ADMIN_GITHUB_LOGINS=
# INTERNAL_ADMIN_GITHUB_IDS=

# Repository installations, installation tokens and App lifecycle hooks.
# GITHUB_APP_SLUG=
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_APP_PRIVATE_KEY_BASE64=
# GITHUB_APP_SETUP_CALLBACK_URL=http://localhost:8080/auth/github/callback
# GITHUB_APP_WEBHOOK_SECRET=

# Tenant MCP and OAuth. Production requires mapped tenant/custom hostnames.
SAAS_MCP_PATH=/mcp
# SAAS_MCP_BASE_DOMAIN=mcp.example.com
MCP_OAUTH_ENABLED=1
# MCP_OAUTH_API_ORIGIN=https://app.example.com
# MCP_OAUTH_RESUME_BASE_URLS=https://app.example.com

# Protect internal requests; use independent random credentials.
INTERNAL_SERVICE_TOKEN=
CRON_SECRET=

# Optional custom-domain provisioning. See domains/README.md for permission scope.
# Choose static VERCEL_TOKEN OR all integration credentials, never both.
# VERCEL_INTEGRATION_CLIENT_ID=
# VERCEL_INTEGRATION_CLIENT_SECRET=
# VERCEL_INTEGRATION_INSTALLATION_ID=icfg_...
# Scope provider access to this project
# as tightly as Vercel permits. No provider token is needed for ordinary serving.
# VERCEL_TOKEN=
# VERCEL_PROJECT_ID=
# VERCEL_TEAM_ID=
